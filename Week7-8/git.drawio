        </mxCell>
        <mxCell id="TCWR51DwXlgikU5Fa6Jc-78" parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;" value="&lt;div style=&quot;background-color: rgb(255, 255, 255); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 18px; white-space: pre;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 128, 0);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;# syntax=docker/dockerfile:1&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 128, 0);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;# Single-stage version, for comparison with the multi-stage Dockerfile.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;FROM&lt;/span&gt; python:3.11-slim&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ENV&lt;/span&gt; PYTHONDONTWRITEBYTECODE=1 &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;\&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;    PYTHONUNBUFFERED=1 &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;\&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;    MODEL_DIR=/app/models&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;WORKDIR&lt;/span&gt; /app&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 128, 0);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;# Same optional line as in Dockerfile: here the build tools stay in the final image.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 128, 0);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;# RUN apt-get update &amp;amp;&amp;amp; apt-get install -y --no-install-recommends build-essential&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;COPY&lt;/span&gt; requirements.txt .&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;RUN&lt;/span&gt; pip install -r requirements.txt&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;COPY&lt;/span&gt; src/ ./src/&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;CMD&lt;/span&gt; [&lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;python&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;-m&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;src.predict&quot;&lt;/span&gt;]&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="269" width="269" x="157" y="1486" as="geometry" />
        </mxCell>
