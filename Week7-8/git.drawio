        <mxCell id="TCWR51DwXlgikU5Fa6Jc-76" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="Build 2&lt;div&gt;from python3.11:ui8 as base_image&lt;/div&gt;&lt;div&gt;RUN, CMD, ENTRYPOINT..&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;background-color: rgb(255, 255, 255); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 18px; white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;COPY&lt;/span&gt; --from=&lt;span style=&quot;font-family: Helvetica; white-space: normal; background-color: rgb(236, 236, 236);&quot;&gt; base_image&lt;/span&gt; /opt/venv /opt/venv&lt;/div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
